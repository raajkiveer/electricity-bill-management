<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Electricity Bill System - Dashboard</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app" data-role="<%= role %>">
    <div class="dashboard">
        <div class="sidebar">
            <h3>Welcome, <%= user %></h3>
            <p>Role: <%= role %></p>
            <button onclick="showPanel('consumerPanel')">Consumer</button>
            <button onclick="showPanel('paymentPanel')">Payment</button>
            <button onclick="showPanel('historyPanel')">Payment History</button>
            <form action="/logout" method="POST" style="margin-top: 20px;">
                <button type="submit">Logout</button>
            </form>
        </div>
        <div class="main-content">
            <div id="consumerPanel" class="panel">
                <h2>Consumer Management</h2>
                <div class="form-container">
                    <h3>Add New Consumer</h3>
                    <form id="addConsumerForm">
                        <input type="text" name="name" placeholder="Name" required>
                        <input type="text" name="address" placeholder="Address">
                        <input type="text" name="phone" placeholder="Phone">
                        <input type="email" name="email" placeholder="Email">
                        <input type="text" name="connectionType" placeholder="Connection Type">
                        <button type="submit">Add Consumer</button>
                    </form>
                </div>
                <h3>Consumer List</h3>
                <% if (role === 'Admin') { %>
                <div class="consumer-filters">
                    <button type="button" class="filter-button active" data-consumer-scope="all">All Consumers</button>
                    <button type="button" class="filter-button" data-consumer-scope="self">My Consumers</button>
                </div>
                <% } %>
                <div class="table-wrap">
                <table id="consumersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Meter ID</th>
                            <% if (role === 'Admin') { %>
                            <th>Action</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                </div>
                <div class="bill-summary">
                    <div class="bill-header">
                        <h3>Meter Bills</h3>
                        <p id="selectedMeterLabel">Select a consumer to view bills.</p>
                    </div>
                    <div class="table-wrap">
                    <table id="meterBillsTable">
                        <thead>
                            <tr>
                                <th>Bill ID</th>
                                <th>Bill Date</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    </div>
                </div>
            </div>

            <div id="paymentPanel" class="panel" style="display: none;">
                <h2>Payment Management</h2>
                <div class="form-container">
                    <h3>Generate Bill</h3>
                    <form id="generateBillForm">
                        <input type="number" name="meterId" placeholder="Meter ID" required>
                        <input type="number" name="units" placeholder="Units Consumed" required>
                        <button type="submit">Generate Bill</button>
                    </form>
                </div>
                <div class="form-container">
                    <h3>Make Payment</h3>
                    <form id="payBillForm">
                        <input type="number" name="billId" placeholder="Bill ID" required>
                        <input type="number" step="0.01" name="amount" placeholder="Amount" required>
                        <input type="text" name="mode" placeholder="Payment Mode" required>
                        <button type="submit">Pay Bill</button>
                    </form>
                </div>
            </div>

            <div id="historyPanel" class="panel" style="display: none;">
                <h2>Payment History</h2>
                <div class="table-wrap">
                <table id="paymentHistoryTable">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Mode</th>
                            <th>Bill ID</th>
                            <% if (role === 'Admin') { %>
                            <th>Consumer</th>
                            <th>Phone</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                </div>
            </div>
        </div>
    </div>

    <script src="/script.js"></script>
</body>
</html>
